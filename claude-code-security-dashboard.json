    {
      "title": "🔎 Investigation",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": false,
      "panels": []
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 9,
      "title": "Flagged Commands",
      "type": "table",
      "description": "Every Sigma match, joined on tool_use_id with Claude Code's tool_result to show whether the command ran successfully and how it was approved. Empty outcome: the command was rejected, is still running, or ran before OTEL_LOG_TOOL_DETAILS was set",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rule"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Rule reference",
                    "targetBlank": true,
                    "url": "${__data.fields[\"Reference\"]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "✅ yes",
                        "index": 0
                      },
                      "false": {
                        "text": "❌ no",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reference"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code-sigma\"} | event_name=\"sigma_match\" | rule_level=~\"${level:regex}\" | rule_title!~\"^(${exclude:raw})$\"",
          "legendFormat": "",
          "refId": "A",
          "queryType": "range",
          "maxLines": 500
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code\"} | event_name=\"tool_result\" | tool_name=~\"Bash|PowerShell\"",
          "legendFormat": "",
          "refId": "B",
          "queryType": "range",
          "maxLines": 2000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": true
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "tool_use_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "rule_title",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time 1": true,
              "rule_level": true,
              "rule_title": true,
              "matched_segment": true,
              "command 1": true,
              "success": true,
              "decision_source": true,
              "permission_mode": true,
              "session_id 1": true,
              "tool_use_id": true,
              "rule_author": true,
              "rule_reference": true
            },
            "indexByName": {
              "Time 1": 0,
              "rule_level": 1,
              "rule_title": 2,
              "matched_segment": 3,
              "success": 4,
              "decision_source": 5,
              "permission_mode": 6,
              "command 1": 7,
              "session_id 1": 8,
              "tool_use_id": 9,
              "rule_author": 10,
              "rule_reference": 11
            },
            "renameByName": {
              "Time 1": "Time",
              "rule_level": "Level",
              "rule_title": "Rule",
              "matched_segment": "Matched segment",
              "success": "Succeeded",
              "decision_source": "Approved by",
              "permission_mode": "Mode",
              "command 1": "Full command",
              "session_id 1": "Session",
