              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "auto",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value/",
          "limit": 15
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (rule_title) (count_over_time({service_name=\"claude-code-sigma\"} | event_name=\"sigma_match\" | rule_level=~\"${level:regex}\" | rule_title!~\"^(${exclude:raw})$\" [$__range])))",
          "legendFormat": "{{rule_title}}",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
