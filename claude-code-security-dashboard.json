      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (tool_use_id) (count_over_time({service_name=\"claude-code-sigma\"} | event_name=\"sigma_match\" | rule_level=~\"${level:regex}\" | rule_title!~\"^(${exclude:raw})$\" [$__range])))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Flagged commands as a share of scanned commands",
