          "expr": "sum by (mitre_tactics, mitre_techniques) (count_over_time({service_name=\"claude-code-sigma\"} | event_name=\"sigma_match\" | rule_level=~\"${level:regex}\" | rule_title!~\"^(${exclude:raw})$\" | mitre_techniques!=\"\" [$__range]))",
