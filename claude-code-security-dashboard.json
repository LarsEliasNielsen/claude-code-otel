          "expr": "sum by (rule_level) (count_over_time({service_name=\"claude-code-sigma\"} | event_name=\"sigma_match\" | rule_level=~\"${level:regex}\" | rule_title!~\"^(${exclude:raw})$\" [$__auto]))",
